# =========================================================================== #
# Konfiguration fuer harness_demo.py
# Client-Auswahl: Foundry wird bevorzugt, sonst OpenAI als Fallback.
# Trage NUR EINE der beiden Varianten ein (Werte ohne Anfuehrungszeichen).
# =========================================================================== #

# --- Variante A: Azure AI Foundry (vorher: az login) ----------------------- #
# Projekt-Endpoint der Foundry-Ressource (Responses API)
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://harness-demo-resource.services.ai.azure.com/api/projects/harness-demo

# Modell-Deployment (optional, Default: gpt-4o)
FOUNDRY_MODEL=gpt-5.2

# --- Variante B: OpenAI / Azure OpenAI (Fallback fuer lokale Demos) --------- #
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Optional: Observability-Demo (--demo observability) ------------------- #
# Traces/Spans direkt in der Konsole ausgeben (fuer die Live-Demo).
# Zeigt sichtbar, dass der Harness orchestriert (agent.run, Chat, Tool-Calls).
ENABLE_CONSOLE_EXPORTERS=true

# OTLP-Exporter-Endpoint, z. B. Aspire Dashboard oder Jaeger
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
